{
  "expo": {
    "name": "lunfit",
    "slug": "lunfit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lunfit",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#24180f",
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#24180f"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#24180f"

      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#24180f"

        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "76424f3e-840c-4196-a645-c6f64638c599"
      }
    }
  }
}
