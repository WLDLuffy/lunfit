# Copy to .env.local and adjust. Only EXPO_PUBLIC_-prefixed vars reach the app
# bundle — never put secrets here, they ship to the client.

# Leave both unset to run against the fixtures in src/data/mock.ts.
# Setting EXPO_PUBLIC_AUTH_URL also switches the login screen off mock auth.

EXPO_PUBLIC_AUTH_URL=http://localhost:8080
# EXPO_PUBLIC_WORKOUT_URL=http://localhost:8081

# On a physical device, use your machine's LAN IP instead of localhost:
# EXPO_PUBLIC_AUTH_URL=http://192.168.1.20:8080
